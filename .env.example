# ScamShield API key — set this in the Supabase Edge Function secrets.
# Do NOT put it in .env or client code. Configure it via the Supabase MCP
# tools or your Supabase dashboard under Edge Functions > Secrets.
#
# The client app does NOT need this key. It only needs the Supabase URL
# and anon key below, which are used to call the analyze edge function.

# --- Client-side (already provisioned by Bolt) ---
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server-side (set as a Supabase Edge Function secret, NOT here) ---
# GEMINI_API_KEY=...           # required by the analyze edge function
# GEMINI_MODEL=gemini-1.5-flash # optional, defaults to gemini-1.5-flash
